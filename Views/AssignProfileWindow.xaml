<Window x:Class="FightingTournament.Views.AssignProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_AssignProfileTitle}"
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        Foreground="{DynamicResource BrushText}"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Border Background="{DynamicResource BrushBg}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1,0,1,1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentDim}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title area -->
                <RowDefinition Height="*"/>    <!-- Select form -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Gradient top border -->
            <Border Height="3" VerticalAlignment="Top" Margin="-20,-20,-20,0" Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource ColorBg}" Offset="0.0"/>
                        <GradientStop Color="{DynamicResource ColorAccent}" Offset="0.5"/>
                        <GradientStop Color="{DynamicResource ColorBg}" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,15" x:Name="TitleArea" Background="Transparent" MouseDown="TitleArea_MouseDown">
                <TextBlock Text="👤" FontSize="32" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="{DynamicResource Loc_AssignProfileHeader}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Selection Field -->
            <StackPanel Grid.Row="1" Margin="10,5,10,15" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc_AssignProfileSelect}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <ComboBox x:Name="ComboPlayers" Margin="0,0,0,10" Padding="8,6" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Actions Row -->
            <Grid Grid.Row="2" Margin="10,0,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnUnassign"
                        Grid.Column="0"
                        Content="{DynamicResource Loc_ProfileUnassign}"
                        Style="{StaticResource BtnGhost}"
                        Padding="10,7"
                        FontSize="11"
                        Click="BtnUnassign_Click"/>

                <Button x:Name="BtnCancel"
                        Grid.Column="2"
                        Content="{DynamicResource Loc_Cancel}"
                        Style="{StaticResource BtnGhost}"
                        Padding="16,7"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>

                <Button x:Name="BtnSave"
                        Grid.Column="3"
                        Content="{DynamicResource Loc_Save}"
                        Style="{StaticResource BtnPrimary}"
                        Padding="20,7"
                        FontSize="11"
                        Click="BtnSave_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
